# GraphQL API the app syncs from. EXPO_PUBLIC_* values are bundled into the app: no real secrets.
# To switch, put overrides in .env.local (gitignored, so a key is never committed),
# then restart with `yarn start --clear`.

# Mock server (default). Physical device: use your machine's LAN IP, e.g. http://192.168.1.10:9002/
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:9002/
EXPO_PUBLIC_GRAPHQL_API_KEY=

# Live AppSync API: copy these two lines into .env.local with the values from aws-exports.js
# EXPO_PUBLIC_GRAPHQL_URL=<aws_appsync_graphqlEndpoint>
# EXPO_PUBLIC_GRAPHQL_API_KEY=<aws_appsync_apiKey>
