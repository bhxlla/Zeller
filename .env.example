# Environment variables used by the app. `.env` holds the committed defaults; to override,
# copy this file to `.env.local` (gitignored) and fill in the values.
# EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.

# GraphQL endpoint.
# - Mock server (default): http://localhost:9002/
#   On the Android emulator, run `adb reverse tcp:9002 tcp:9002` so localhost reaches your machine.
# - Physical device: use your machine's LAN IP, e.g. http://192.168.1.10:9002/
EXPO_PUBLIC_GRAPHQL_URL=

# AppSync API key. Leave empty for the mock server.
EXPO_PUBLIC_GRAPHQL_API_KEY=
